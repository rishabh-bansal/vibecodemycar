# Copy to .env.local for local overrides. Every VITE_* value is public (shipped to browsers).

# Car photos (public/cars, public/f/hero) are the owner's own and ship by default. 0 drops them.
VITE_CAR_IMAGES=1

# Affiliate / shop link behind "No adapter? Buy on Amazon".
VITE_ADAPTER_URL=https://www.amazon.in/s?k=elm327+bluetooth+obd2
