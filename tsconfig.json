{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "paths": { "@/*": ["./src/*"] },
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true
  },
  "include": [
    "src",
    "packages/*/src",
    "packages/*/test",
    "workers/*/src",
    "workers/*/test",
    "vite.config.ts",
    "scripts/capture-browser.ts"
  ]
}
