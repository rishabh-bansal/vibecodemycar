/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://obdcraft-logs.rishabhbansal1855.workers.dev; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: bluetooth=(self), camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Photo names are image ids, not content hashes: a re-encoded photo keeps its name, so it must revalidate.
/f/*
  Cache-Control: public, max-age=86400, must-revalidate

/cars/*
  Cache-Control: public, max-age=86400, must-revalidate
