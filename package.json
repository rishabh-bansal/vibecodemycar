{
  "name": "obdcraft",
  "private": true,
  "version": "0.1.0",
  "description": "Vibecode my car — free, self-serve car coding for Indian-market Škoda & VW (Bluetooth ELM327 → backup → write → read-back)",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "biome check src",
    "format": "biome format --write src",
    "check": "npm run typecheck && npm run lint && npm run check:data && npm test && npm run build && npm run check:public",
    "check:data": "node scripts/build-data.mjs --check",
    "private-test:build": "VITE_PRIVATE_TEST=1 VITE_LOG_ENDPOINT=https://obdcraft-logs.rishabhbansal1855.workers.dev vite build --outDir dist-private",
    "logs:deploy": "wrangler d1 migrations apply obdcraft-logs --remote --config workers/logs/wrangler.jsonc && wrangler deploy --config workers/logs/wrangler.jsonc",
    "logs:verify": "node scripts/verify-cloud-logs.ts https://obdcraft-logs.rishabhbansal1855.workers.dev",
    "logs:pull": "node scripts/logs-pull.mjs",
    "logs:summary": "node scripts/logs-summary.mjs",
    "deploy:site-test": "npm run check && VITE_PRIVATE_TEST=1 VITE_LOG_ENDPOINT=https://obdcraft-logs.rishabhbansal1855.workers.dev vite build && node scripts/check-public-build.mjs && wrangler pages deploy dist --project-name vibecodemycar --branch main",
    "private-test:serve": "vite preview --outDir dist-private --host localhost --port 4173 --strictPort",
    "check:public": "node scripts/check-public-build.mjs",
    "data": "node scripts/build-data.mjs",
    "catalogue": "node scripts/build-catalogue.mjs && node scripts/build-public-catalogue.mjs",
    "catalogue:public": "node scripts/build-public-catalogue.mjs",
    "deploy": "npm run check && wrangler pages deploy dist --project-name vibecodemycar --branch main && wrangler pages deploy dist --project-name obdcraft --branch main",
    "live": "node scripts/live.ts",
    "live:bridge": "sh tools/live/build.sh && tools/live/bin/elm-bridge",
    "live:fake": "node scripts/live/fake-bridge.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "4.88.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/rishabh-bansal/vibecodemycar.git"
  },
  "homepage": "https://vibecodemycar.pages.dev"
}
